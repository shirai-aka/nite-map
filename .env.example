# このファイルを .env という名前でコピーし、値を書き込んで使う。
# .env は .gitignore 済みなのでコミットされない。
#
#   cp .env.example .env
#   (.env を編集)
#   node --env-file=.env build.js

# 楽天ウェブサービス(https://webservice.rakuten.co.jp/)で発行
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイトのタグ(例: xxxx-22)。無くてもビルドは通る
AMAZON_TAG=

# Google Maps Platform(Maps JavaScript API)
# キーは必ず「ウェブサイトの制限」と「1日あたりの割り当て」を設定してから使う
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_MAP_ID=
